# focus window
ctrl - h : yabai -m window --focus west
ctrl - j : yabai -m window --focus south
ctrl - k : yabai -m window --focus north
ctrl - l : yabai -m window --focus east

# swap managed window
ctrl + shift - h : yabai -m window --swap west
ctrl + shift - j : yabai -m window --swap south
ctrl + shift - k : yabai -m window --swap north
ctrl + shift - l : yabai -m window --swap east

# move managed window
shift + cmd + ctrl - h : yabai -m window --warp west
shift + cmd + ctrl - j : yabai -m window --warp south
shift + cmd + ctrl - k : yabai -m window --warp north
shift + cmd + ctrl - l : yabai -m window --warp east

# toggle window fullscreen zoom
ctrl - f : yabai -m window --toggle zoom-fullscreen;

# toggle padding and gap
ctrl - g : yabai -m space --toggle padding; yabai -m space --toggle gap

# float / unfloat window and center on screen
ctrl - t : yabai -m window --toggle float;\
          yabai -m window --grid 4:4:1:1:2:2

# toggle window split type
# ctrl - e : yabai -m window --toggle split

# balance size of windows
# shift + alt - 0 : yabai -m space --balance

# increase window size
shift + cmd - h : yabai -m window --resize left:-20:0
shift + cmd - j : yabai -m window --resize bottom:0:20
shift + cmd - k : yabai -m window --resize top:0:-20
shift + cmd - l : yabai -m window --resize right:20:0

# decrease window size
cmd + ctrl - h : yabai -m window --resize left:20:0
cmd + ctrl - j : yabai -m window --resize bottom:0:-20
cmd + ctrl - k : yabai -m window --resize top:0:20
cmd + ctrl - l : yabai -m window --resize right:-20:0

# change layout
ctrl + shift - z : yabai -m space --layout bsp

# change desktops
ctrl - 1 : yabai -m space --focus 1
ctrl - 2 : yabai -m space --focus 2
ctrl - 3 : yabai -m space --focus 3
ctrl - 4 : yabai -m space --focus 4
ctrl - 5 : yabai -m space --focus 5
ctrl - 6 : yabai -m space --focus 6
ctrl - 7 : yabai -m space --focus 7
ctrl - 8 : yabai -m space --focus 8
ctrl - 9 : yabai -m space --focus 9
ctrl - 0 : yabai -m space --focus 10

# move current window to following desktops
shift + ctrl - 1 : yabai -m window --space 1
shift + ctrl - 2 : yabai -m window --space 2
shift + ctrl - 3 : yabai -m window --space 3
shift + ctrl - 4 : yabai -m window --space 4
shift + ctrl - 5 : yabai -m window --space 5
shift + ctrl - 6 : yabai -m window --space 6
shift + ctrl - 7 : yabai -m window --space 7
shift + ctrl - 8 : yabai -m window --space 8
shift + ctrl - 9 : yabai -m window --space 9
shift + ctrl - 0 : yabai -m window --space 10
